# Flask application security
SECRET_KEY=replace-with-a-long-random-secret-key

# Database
# Default local SQLite example:
DATABASE_URL=sqlite:///license_plate_game.db

# MariaDB/MySQL example:
# DATABASE_URL=mysql+pymysql://username:password@host:3306/license_plate_game

# Flask-Mail / Gmail SMTP
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_DEFAULT_SENDER=your_email@gmail.com

# Application behavior
FLASK_ENV=production
FLASK_DEBUG=False

# Optional public app URL used in emails/password resets
APP_BASE_URL=https://licenseplate.example.com
